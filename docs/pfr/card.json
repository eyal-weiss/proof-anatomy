 "statement": {
  "main_file": "PFR/Main.lean",
  "sentences": [
   "PFR_conjecture is stated with Mathlib's own definitions AddCommGroup, Module, ZMod, Set, Submodule and Nat.card."
  ],
  "trace": [
   [
    {
     "name": "PFR_conjecture",
     "file": "PFR/Main.lean",
     "kind": "theorem",
     "depth": 0,
     "text": "theorem PFR_conjecture {G : Type*} [AddCommGroup G] [Module (ZMod 2) G]\n    {A : Set G} {K : ℝ} (hA₀ : A.Nonempty) (Afin : A.Finite)\n    (hA : (A + A).ncard ≤ K * A.ncard) :\n    ∃ (H : Submodule (ZMod 2) G) (c : Set G), c.Finite ∧ (H : Set G).Finite ∧\n      Nat.card c < 2 * K ^ 12 ∧ (H : Set G).ncard ≤ A.ncard ∧ A ⊆ c + H",
