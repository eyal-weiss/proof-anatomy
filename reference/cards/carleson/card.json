     "name": "classical_carleson",
     "file": "Carleson/Classical/ClassicalCarleson.lean",
     "kind": "theorem",
     "depth": 0,
     "text": "theorem classical_carleson {f : ℝ → ℂ} (cont_f : Continuous f) (periodic_f : f.Periodic (2 * π)) :\n    ∀ᵐ x, Tendsto (S_ · f x) atTop (𝓝 (f x))",
